{
  "name": "nfl-loser-pickem-bot",
  "version": "1.0.0",
  "description": "A workspace-scoped bot for running NFL Loser Pick'em leagues across Slack and Discord",
  "main": "src/index.ts",
  "scripts": {
    "dev": "wrangler dev",
    "build": "tsc",
    "start": "wrangler deploy",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:integration": "jest --testPathPattern=integration",
    "d1:create": "wrangler d1 create nfl-loser-pickem-db",
    "d1:migrate:local": "wrangler d1 migrations apply nfl-loser-pickem-db --local",
    "d1:migrate:remote": "wrangler d1 migrations apply nfl-loser-pickem-db --remote",
    "d1:console:local": "wrangler d1 execute nfl-loser-pickem-db --local",
    "d1:console:remote": "wrangler d1 execute nfl-loser-pickem-db --remote",
    "seed:teams": "wrangler d1 execute nfl-loser-pickem-db --local --file=./scripts/seed-teams.sql",
    "seed:season": "wrangler d1 execute nfl-loser-pickem-db --local --file=./scripts/seed-season-2025.sql",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write \"src/**/*.ts\""
  },
  "keywords": [
    "nfl",
    "picks",
    "loser",
    "slack",
    "discord",
    "bot"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@slack/bolt": "^3.17.0",
    "discord.js": "^14.14.1",
    "dotenv": "^16.4.1",
    "axios": "^1.6.5",
    "date-fns": "^3.6.0",
    "date-fns-tz": "^3.2.0"
  },
  "optionalDependencies": {
    "canvas": "^2.11.2"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@types/node-cron": "^3.0.11",
    "@types/jest": "^29.5.14",
    "@cloudflare/workers-types": "^4.20241127.0",
    "typescript": "^5.6.3",
    "tsx": "^4.19.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "@typescript-eslint/eslint-plugin": "^8.11.0",
    "@typescript-eslint/parser": "^8.11.0",
    "eslint": "^9.13.0",
    "prettier": "^3.3.3",
    "wrangler": "^3.86.1",
    "better-sqlite3": "^11.7.0",
    "@types/better-sqlite3": "^7.6.12"
  },
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  }
}
