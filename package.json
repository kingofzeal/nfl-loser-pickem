{
  "name": "nfl-loser-pickem-bot",
  "version": "1.0.0",
  "description": "A workspace-scoped bot for running NFL Loser Pick'em leagues across Slack and Discord",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:integration": "jest --testPathPattern=integration",
    "migrate:up": "node-pg-migrate up",
    "migrate:down": "node-pg-migrate down",
    "migrate:create": "node-pg-migrate create",
    "seed:teams": "tsx scripts/seed-teams.ts",
    "seed:season": "tsx scripts/seed-season.ts",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write \"src/**/*.ts\""
  },
  "keywords": [
    "nfl",
    "picks",
    "loser",
    "slack",
    "discord",
    "bot"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@slack/bolt": "^3.17.0",
    "discord.js": "^14.14.1",
    "pg": "^8.11.3",
    "dotenv": "^16.4.1",
    "axios": "^1.6.5",
    "node-cron": "^3.0.3",
    "date-fns": "^3.6.0",
    "date-fns-tz": "^3.2.0"
  },
  "optionalDependencies": {
    "canvas": "^2.11.2"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@types/pg": "^8.10.9",
    "@types/node-cron": "^3.0.11",
    "@types/jest": "^29.5.14",
    "typescript": "^5.6.3",
    "tsx": "^4.19.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "@typescript-eslint/eslint-plugin": "^8.11.0",
    "@typescript-eslint/parser": "^8.11.0",
    "eslint": "^9.13.0",
    "prettier": "^3.3.3",
    "node-pg-migrate": "^7.7.1"
  },
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  }
}
