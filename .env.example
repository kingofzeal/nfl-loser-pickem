# Environment variables for NFL Loser Pick'em Bot

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/nfl_pickem

# Slack Bot
SLACK_BOT_TOKEN=xoxb-your-slack-bot-token
SLACK_SIGNING_SECRET=your-slack-signing-secret
SLACK_APP_TOKEN=xapp-your-slack-app-token

# Discord Bot
DISCORD_BOT_TOKEN=your-discord-bot-token
DISCORD_CLIENT_ID=your-discord-client-id

# Data Source (espn or thesportsdb)
DATA_SOURCE=espn
ESPN_API_BASE_URL=https://site.api.espn.com
THESPORTSDB_API_KEY=your-api-key-here

# Sync Configuration
SYNC_INTERVAL_MINUTES=60
SYNC_ENABLED=true

# Timezone (default workspace timezone)
DEFAULT_TIMEZONE=America/New_York

# Scheduler
ENABLE_SCHEDULER=true
WEEK_OPEN_CRON=0 9 * * 2
REMINDER_FRIDAY_CRON=0 10 * * 5
REMINDER_SUNDAY_CRON=0 9 * * 0
SYNC_GAMES_CRON=0 * * * *

# Server
PORT=3000
NODE_ENV=development

# Logging
LOG_LEVEL=info

# Image Generation
IMAGE_OUTPUT_PATH=./public/images
IMAGE_BASE_URL=https://your-cdn.com/images

# Archive & Export
ARCHIVE_ENABLED=true
ARCHIVE_EXPORT_PATH=./archives
ARCHIVE_AUTO_AFTER_DAYS=90
